{
  "project": "AI-Powered To-Do-List",
  "version": "1.0",
  "designSystem": {
    "colors": {
      "primary": "#6366F1",
      "secondary": "#8B5CF6",
      "success": "#10B981",
      "danger": "#EF4444",
      "warning": "#F59E0B",
      "info": "#0EA5E9",
      "neutral": {
        "50": "#F9FAFB",
        "100": "#F3F4F6",
        "200": "#E5E7EB",
        "300": "#D1D5DB",
        "400": "#9CA3AF",
        "500": "#6B7280",
        "600": "#4B5563",
        "700": "#374151",
        "800": "#1F2937",
        "900": "#111827"
      }
    },
    "typography": {
      "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
      "headings": {
        "h1": {"size": "32px", "weight": 700, "lineHeight": "1.2"},
        "h2": {"size": "24px", "weight": 700, "lineHeight": "1.3"},
        "h3": {"size": "20px", "weight": 600, "lineHeight": "1.4"},
        "h4": {"size": "16px", "weight": 600, "lineHeight": "1.4"},
        "h5": {"size": "14px", "weight": 600, "lineHeight": "1.5"}
      },
      "body": {
        "regular": {"size": "14px", "weight": 400},
        "medium": {"size": "14px", "weight": 500},
        "small": {"size": "12px", "weight": 400}
      }
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px",
      "2xl": "48px"
    },
    "borderRadius": {
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "full": "9999px"
    },
    "shadows": {
      "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
      "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)"
    }
  },
  "pages": {
    "dashboard": {
      "name": "Main Dashboard",
      "description": "Primary view showing all tasks and insights",
      "layout": "grid",
      "components": [
        {
          "id": "header",
          "type": "header",
          "elements": [
            {"type": "logo", "text": "AI To-Do"},
            {"type": "userMenu", "includes": ["profile", "settings", "logout"]}
          ]
        },
        {
          "id": "sidebar",
          "type": "navigation",
          "position": "left",
          "width": "250px",
          "items": [
            {"label": "Today", "icon": "calendar-check"},
            {"label": "This Week", "icon": "calendar-week"},
            {"label": "All Tasks", "icon": "list"},
            {"label": "Completed", "icon": "check-circle"},
            {"label": "Categories", "icon": "tag"},
            {"label": "Insights", "icon": "chart-bar"}
          ]
        },
        {
          "id": "mainContent",
          "type": "container",
          "gridColumns": 2,
          "sections": [
            {
              "id": "prioritizedTasks",
              "title": "Today's Tasks (AI Prioritized)",
              "type": "taskList",
              "width": "60%",
              "columns": 1,
              "features": ["dragDrop", "quickComplete", "expand"]
            },
            {
              "id": "aiInsights",
              "title": "AI Insights",
              "type": "insightsPanel",
              "width": "40%",
              "items": [
                {"label": "Recommended Focus", "type": "stat"},
                {"label": "Productivity Score", "type": "gauge"},
                {"label": "Next Deadline", "type": "alert"},
                {"label": "Suggested Break Time", "type": "suggestion"}
              ]
            }
          ]
        },
        {
          "id": "actionButton",
          "type": "button",
          "style": "fab",
          "action": "createTask",
          "label": "+",
          "color": "primary",
          "position": "bottomRight"
        }
      ]
    },
    "taskDetail": {
      "name": "Task Detail View",
      "description": "Full task viewing and editing interface",
      "layout": "twoColumn",
      "components": [
        {
          "id": "taskForm",
          "type": "form",
          "fields": [
            {"name": "title", "type": "text", "required": true, "placeholder": "Task title"},
            {"name": "description", "type": "textarea", "placeholder": "Add description"},
            {"name": "dueDate", "type": "date", "required": true},
            {"name": "priority", "type": "select", "options": ["Low", "Medium", "High", "Urgent"]},
            {"name": "category", "type": "select", "options": ["Work", "Personal", "Academics", "Health"]},
            {"name": "estimatedTime", "type": "number", "unit": "minutes", "placeholder": "Estimated time to complete"},
            {"name": "tags", "type": "multiselect", "placeholder": "Add tags"}
          ]
        },
        {
          "id": "aiSuggestions",
          "type": "panel",
          "title": "AI Suggestions",
          "items": [
            {"label": "Subtask Suggestions", "type": "list", "action": "acceptSubtasks"},
            {"label": "Optimal Study Time", "type": "text", "action": "scheduleTime"},
            {"label": "Similar Past Tasks", "type": "list", "action": "viewHistory"}
          ]
        },
        {
          "id": "subtasks",
          "type": "subtaskList",
          "title": "Subtasks",
          "addButton": true,
          "columns": ["Name", "Status", "DueDate"]
        }
      ]
    },
    "createTask": {
      "name": "Create Task Modal",
      "description": "Modal for quickly creating new tasks",
      "type": "modal",
      "components": [
        {
          "id": "inputMethod",
          "type": "tabs",
          "options": ["Natural Language", "Form", "AI Assist"]
        },
        {
          "id": "nlpInput",
          "type": "textInput",
          "placeholder": "Type naturally: 'Study for CS exam next Friday at 2pm'",
          "multiline": true,
          "helpText": "AI will parse and extract task details"
        },
        {
          "id": "formInput",
          "type": "form",
          "fields": [
            {"name": "title", "type": "text"},
            {"name": "dueDate", "type": "date"},
            {"name": "dueTime", "type": "time"},
            {"name": "priority", "type": "select"}
          ]
        },
        {
          "id": "preview",
          "type": "panel",
          "title": "Parsed Task",
          "elements": [
            {"label": "Title:", "type": "text"},
            {"label": "Due Date:", "type": "text"},
            {"label": "Priority:", "type": "badge"}
          ]
        },
        {
          "id": "actions",
          "type": "buttonGroup",
          "buttons": [
            {"label": "Cancel", "action": "cancel"},
            {"label": "Create", "action": "submit", "style": "primary"}
          ]
        }
      ]
    },
    "insights": {
      "name": "Insights & Analytics",
      "description": "View productivity insights and trends",
      "components": [
        {
          "id": "dailyBriefing",
          "type": "card",
          "title": "Today's Briefing",
          "items": ["tasksCount", "deadlines", "recommendations"]
        },
        {
          "id": "weeklyStats",
          "type": "chart",
          "title": "Weekly Overview",
          "chartType": "bar",
          "metrics": ["tasksCreated", "tasksCompleted", "completionRate"]
        },
        {
          "id": "productivityTrends",
          "type": "chart",
          "title": "Productivity Trends",
          "chartType": "line",
          "timeRange": "4weeks",
          "metric": "completionRate"
        },
        {
          "id": "peakProductivity",
          "type": "chart",
          "title": "Most Productive Hours",
          "chartType": "heatmap",
          "dimensions": ["dayOfWeek", "hour"]
        },
        {
          "id": "categoryBreakdown",
          "type": "chart",
          "title": "Tasks by Category",
          "chartType": "pie",
          "metrics": ["tasksPerCategory"]
        }
      ]
    }
  },
  "dataStructures": {
    "task": {
      "id": "string (UUID)",
      "userId": "string (foreign key)",
      "title": "string (required)",
      "description": "string",
      "dueDate": "datetime (required)",
      "priority": "enum [Low, Medium, High, Urgent]",
      "status": "enum [Pending, InProgress, Completed, Archived]",
      "category": "string",
      "tags": "array of strings",
      "estimatedTime": "integer (minutes)",
      "actualTime": "integer (minutes)",
      "subtasks": "array of subtask objects",
      "createdAt": "datetime",
      "completedAt": "datetime",
      "aiPriority": "number (0-100)",
      "nlpExtraction": {
        "rawInput": "string",
        "parsedEntities": "object",
        "confidence": "number"
      }
    },
    "subtask": {
      "id": "string (UUID)",
      "taskId": "string (foreign key)",
      "title": "string",
      "completed": "boolean",
      "dueDate": "datetime",
      "order": "integer",
      "createdAt": "datetime"
    },
    "user": {
      "id": "string (UUID)",
      "email": "string (unique)",
      "passwordHash": "string",
      "displayName": "string",
      "avatar": "string (URL)",
      "academicLevel": "enum [HighSchool, Undergraduate, Graduate]",
      "preferences": {
        "reminderFrequency": "enum [disabled, hourly, daily, weekly]",
        "theme": "enum [light, dark, auto]",
        "timeZone": "string"
      },
      "createdAt": "datetime",
      "lastLogin": "datetime"
    },
    "insight": {
      "userId": "string (foreign key)",
      "date": "date",
      "metrics": {
        "tasksCreated": "integer",
        "tasksCompleted": "integer",
        "completionRate": "number (0-100)",
        "avTimeSpent": "integer (minutes)",
        "topCategory": "string",
        "mostProductiveHour": "integer (0-23)"
      }
    }
  },
  "apiEndpoints": {
    "tasks": {
      "GET": "/api/tasks",
      "POST": "/api/tasks",
      "GET_DETAIL": "/api/tasks/:id",
      "PUT": "/api/tasks/:id",
      "DELETE": "/api/tasks/:id"
    },
    "ai": {
      "NLP_PARSE": "POST /api/ai/parse-task",
      "PRIORITIZE": "POST /api/ai/prioritize-tasks",
      "DECOMPOSE": "POST /api/ai/decompose-task",
      "SUGGEST_TIME": "GET /api/ai/suggest-time/:taskId"
    },
    "insights": {
      "DAILY_BRIEFING": "GET /api/insights/daily-briefing",
      "WEEKLY_STATS": "GET /api/insights/weekly-stats",
      "TRENDS": "GET /api/insights/trends",
      "PRODUCTIVITY_HOURS": "GET /api/insights/productivity-hours"
    }
  }
}
